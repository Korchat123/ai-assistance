# Local browser speech recognition and synthesis are the default.
VITE_VOICE_PROVIDER=local

# To use OpenAI Realtime instead:
# VITE_VOICE_PROVIDER=openai-realtime
# VITE_REALTIME_TOKEN_URL=http://127.0.0.1:8000/realtime/client-secret

# Optional WebSocket override.
# VITE_AGENT_WS_URL=ws://127.0.0.1:8000/ws
