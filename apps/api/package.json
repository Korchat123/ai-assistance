{
  "name": "@live2d-agent/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "canary": "tsx src/canary.ts",
    "dev": "tsx watch src/server.ts",
    "delete:client-data": "tsx src/delete-client-data.ts",
    "migrate": "tsx src/migrate.ts",
    "start": "node dist/server.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/websocket": "11.3.0",
    "@live2d-agent/protocol": "workspace:*",
    "@openai/agents": "0.13.5",
    "dotenv": "17.2.3",
    "fastify": "5.10.0",
    "pg": "8.22.0",
    "ws": "8.18.3",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/pg": "8.20.0",
    "@types/ws": "8.18.1",
    "tsx": "4.20.6",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  }
}
