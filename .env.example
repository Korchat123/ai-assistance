# Local Ollama is the default provider and does not require an API key.
AGENT_PROVIDER=ollama
OLLAMA_MODEL=gemma3
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Optional OpenAI alternative. Set AGENT_PROVIDER=openai to use these.
# OPENAI_API_KEY=sk-your-key-here
# OPENAI_MODEL=gpt-5-codex

# OpenAI Realtime voice will use this server-side key when that optional
# provider is enabled. Never expose it as a VITE_ environment variable.
# OPENAI_REALTIME_MODEL=your-realtime-model-id

# Optional API listen port.
PORT=8000
