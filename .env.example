# Local Ollama is the default provider and does not require an API key.
AGENT_PROVIDER=ollama
OLLAMA_MODEL=gemma3
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Optional durable persistence. Without this, the API uses in-memory storage.
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/live2d_agent

# Optional OpenAI alternative. Set AGENT_PROVIDER=openai to use these.
# OPENAI_API_KEY=sk-your-key-here
# OPENAI_MODEL=gpt-5-codex

# Optional OpenAI Realtime voice. It uses OPENAI_API_KEY on the server even
# when the text agent remains on Ollama. Never expose the key as a VITE_ value.
# OPENAI_REALTIME_MODEL=gpt-realtime-2.1
# OPENAI_REALTIME_VOICE=marin
# WEB_ORIGIN=http://127.0.0.1:5173

# Optional API listen port.
PORT=8000
